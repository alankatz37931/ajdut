# ─── Base de datos ─────────────────────────────────────────────────
# Neon, Supabase, Railway o Postgres local.
# En Neon: DATABASE_URL = string CON pooling (host con "-pooler"), la usa
# la app en runtime. DIRECT_URL = string DIRECTA (sin "-pooler"), la usa
# `prisma db push` / migraciones. En local pueden ser la misma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajdut?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ajdut?schema=public"

# ─── Auth.js ───────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32  (o `npx auth secret`)
# En producción (Vercel) AUTH_URL y NEXT_PUBLIC_APP_URL DEBEN ser el dominio
# real: https://ajdut.com — NO localhost. De eso dependen los links de los
# emails y el redirect del logout. (Si quedan en localhost, el código igual
# cae al dominio de prod por seguridad, pero conviene setearlas bien.)
AUTH_SECRET="cambia-esto-en-produccion"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Vercel Blob (storage de archivos) ─────────────────────────────
# Lo usa @vercel/blob en /api/uploads/presign para autorizar las subidas
# desde el browser. En Vercel se genera al crear el Blob store; en local,
# copiarlo desde el dashboard (Storage → Blob → .env.local).
BLOB_READ_WRITE_TOKEN=""

# ─── Resend (email transaccional) ──────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AJDUT <no-reply@ajdut.io>"
# Emails de admins a notificar (separados por coma)
ADMIN_NOTIFY_EMAILS="admin@ajdut.io"

# ─── Bootstrap del Admin inicial ───────────────────────────────────
# Estos valores se usan SOLO en el seed inicial. En producción, generar
# el primer admin manualmente con una migración firmada.
BOOTSTRAP_ADMIN_EMAIL="admin@ajdut.io"
BOOTSTRAP_ADMIN_PASSWORD="cambia-esto-tras-primer-login"
BOOTSTRAP_ADMIN_NAME="Admin AJDUT"
