// AJDUT — Schema de base de datos
// Filosofía: Cero Transacciones · Trazabilidad de Legado · Gatekeeping Estricto
// Toda transferencia de propiedad genera un registro inmutable en OwnershipHistory.
// Las cifras monetarias se almacenan en Decimal; los IDs son cuid.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── IDENTIDAD Y GATEKEEPING ────────────────────────────────────────

enum UserRole {
  ADMIN
  PROJECT_OWNER
  CO_ADMIN
  PARTNER
  PLATFORM
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Tipo de aplicante: PERSON pide entrar como miembro; COMPANY pide entrar
// como project owner (responsable de un proyecto). El kind define qué
// campos opcionales esperamos (companyName / companyDescription / companyKind)
// y qué rol pre-seleccionamos en la aprobación.
enum ApplicantKind {
  PERSON
  COMPANY
}

model Application {
  id                 String            @id @default(cuid())
  fullName           String
  email              String            @unique
  phone              String
  country            String
  motivation         String
  referredBy         String?
  kind               ApplicantKind     @default(PERSON)
  // Cuando kind == COMPANY el aplicante describe el proyecto que quiere
  // registrar. phone y country siguen siendo del responsable.
  companyName        String?
  companyDescription String?
  companyKind        ProjectKind?
  status             ApplicationStatus @default(PENDING)
  // El email del aplicante quedó verificado al momento de enviar (vía código OTP).
  // Si una aplicación llegó por algún path legacy sin verificación, queda nullable.
  emailVerifiedAt    DateTime?
  reviewedById       String?
  reviewedBy         User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  rejectionNote      String?
  createdUser        User?             @relation("ApplicationOrigin")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([reviewedById])
}

// Códigos one-time para verificar el email antes de crear la Application.
// El "payload" guarda los datos del form firmados/serializados — recién creamos
// la Application cuando el usuario ingresa el código correcto.
model EmailVerificationCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  payload    Json
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  // passwordHash es nullable: usuarios recién aprobados existen sin contraseña
  // hasta que la establecen vía PasswordSetupToken.
  passwordHash  String?
  fullName      String
  // Alias visible para otros miembros (ej. cap table). Si null, se cae al fullName.
  // El propio dueño siempre ve su nombre real en /partner y /certificado/[id].
  alias         String?
  // ─── Ola 7d — Storage R2 ──────────────────────────────────────────
  // Avatar visible (sidebar, headers de comentarios, etc.). URL pública.
  // Si null se cae a iniciales en círculo. La sube el usuario desde /perfil
  // (FileUpload → presigned R2). En entornos sin R2 configurado, puede ser
  // una URL externa pegada (Drive, etc.).
  avatarUrl     String?
  // Foto/escaneo del documento de identidad. URL pública dentro del bucket
  // privado (no exponer en feeds; solo se ve desde /perfil del propio dueño
  // y desde el panel admin para KYC). Mismo fallback URL manual que avatar.
  idPhotoUrl    String?
  // Contacto editable post-aplicación. Heredados de la Application al
  // aprobar; el miembro puede actualizarlos desde /perfil cuando cambien.
  country       String?
  phone         String?
  role          UserRole
  isActive      Boolean      @default(true)
  applicationId String?      @unique
  application   Application? @relation("ApplicationOrigin", fields: [applicationId], references: [id])

  // 2FA (TOTP) — TODO: 2FA feature deferred — schema fields kept for forward compat.
  // No hay código que lea/escriba estos campos hoy; eliminarlos sería destructivo
  // para data existente. Mantenidos hasta que se reactive la feature de TOTP.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // ─── Ola 7b — Herederos y validación de vida ──────────────────────
  // Cada cuántos meses AJDUT le pide al miembro que confirme que sigue activo.
  // Valores permitidos: 0 (deshabilitado), 1, 3 (default), 6, 12.
  validationFrequencyMonths Int       @default(3)
  // Última vez que el miembro confirmó manualmente. Si null nunca confirmó.
  lastValidationConfirmedAt DateTime?
  // Contador de checks PENDING que vencieron sin respuesta. Se resetea al
  // confirmar. Cuando llega a 3 disparamos heirsEscalated.
  missedValidationCount     Int       @default(0)
  // True cuando el admin ya recibió el alerta para contactar a los herederos.
  // Evita re-disparar el alerta en cada cron-pass.
  heirsEscalated            Boolean   @default(false)

  // Relaciones inversas
  ownedProjects         Project[]              @relation("ProjectOwner")
  coAdminAssignments    ProjectCoAdmin[]
  participationsOwned   Participation[]        @relation("CurrentOwner")
  ownershipFrom         OwnershipHistory[]     @relation("TransferFrom")
  ownershipTo           OwnershipHistory[]     @relation("TransferTo")
  ownershipAuthorized   OwnershipHistory[]     @relation("AuthorizedBy")
  ownershipCoAuthorized OwnershipHistory[]     @relation("CoAuthorizedBy")
  leads                 Lead[]
  resaleListings        ResaleListing[]
  messages              Message[]
  messagesDeleted       Message[]              @relation("MessageDeleter")
  pollsCreated          Poll[]                 @relation("PollCreator")
  pollVotes             PollVote[]             @relation("PollVoter")
  applicationsReviewed  Application[]          @relation("ApplicationReviewer")
  auditEntries          AuditLog[]
  notifications         Notification[]
  dividendDeclared      DividendDistribution[] @relation("DividendDeclarer")
  dividendPayments      DividendPayment[]
  passwordSetupTokens   PasswordSetupToken[]
  infoRequests          InfoRequest[]          @relation("InfoRequester")
  infoRequestsReviewed  InfoRequest[]          @relation("InfoRequestReviewer")
  pendingProposed       PendingAssignment[]    @relation("PendingAssignmentProposer")
  pendingTargeted       PendingAssignment[]    @relation("PendingAssignmentTarget")
  pendingReviewed       PendingAssignment[]    @relation("PendingAssignmentReviewer")
  heirs                 Heir[]                 @relation("HeirOwner")
  validationChecks      ValidationCheck[]      @relation("ValidationUser")

  @@index([role, isActive])
}

// ─── HEREDEROS Y VALIDACIÓN DE VIDA (Ola 7b) ────────────────────────
//
// Cada miembro declara herederos con un % de reparto (suma <= 100). Si el
// miembro deja de responder N verificaciones consecutivas, el admin recibe
// alerta para contactarlos. AJDUT no ejecuta transferencias automáticas —
// solo notifica al equipo para que actúe humanamente.

model Heir {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("HeirOwner", fields: [userId], references: [id])
  fullName     String
  email        String?
  relationship String? // "hermana", "cónyuge", "hijo", texto libre
  sharePercent Decimal  @db.Decimal(5, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, email])
  @@index([userId])
}

enum ValidationCheckStatus {
  PENDING
  CONFIRMED
  MISSED
}

model ValidationCheck {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation("ValidationUser", fields: [userId], references: [id])
  sentAt      DateTime              @default(now())
  respondedAt DateTime?
  status      ValidationCheckStatus @default(PENDING)
  escalatedAt DateTime?

  // SHA-256 hash del token plano que viaja en el link del email. El plano
  // nunca se almacena. Se setea a null al confirmar (invalidación) y al
  // marcar como MISSED (defense in depth). Nullable porque los registros
  // creados antes de Ola 7b-security no tienen token.
  tokenHash      String?   @unique
  // Fecha de expiración del token. Si null, no expira (legacy). Si pasada,
  // la ruta /confirmar-vida lo rechaza aunque el status sea PENDING.
  tokenExpiresAt DateTime?

  @@index([userId, sentAt])
}

// ─── TOKENS DE SETEO DE CONTRASEÑA ──────────────────────────────────
// Cuando un Admin aprueba una Application, NO genera contraseña. En su lugar
// crea un PasswordSetupToken válido por 24h. El usuario recibe un link único
// y elige su propia contraseña. Patrón estándar (Stripe, Linear, Vercel).

enum PasswordSetupTokenKind {
  INITIAL_SETUP // primera vez tras aprobación de Application
  RESET // olvido de contraseña (futuro)
  BOOTSTRAP // admin bootstrap inicial (futuro)
}

model PasswordSetupToken {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id])
  // SHA-256 del token plano. El plano nunca se almacena; solo viaja en el link.
  tokenHash String                 @unique
  kind      PasswordSetupTokenKind @default(INITIAL_SETUP)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime               @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

// ─── PROYECTOS ──────────────────────────────────────────────────────

enum ProjectKind {
  STARTUP
  REAL_ESTATE
  MERCHANDISE
  OTHER
}

enum ProjectStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED
}

model Project {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  kind             ProjectKind   @default(STARTUP)
  status           ProjectStatus @default(DRAFT)
  ownerId          String
  owner            User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  shortPitch       String        @db.VarChar(280)
  description      String
  totalShares      Int
  shareUnitLabel   String        @default("participación")
  coverImageKey    String?
  startsAt         DateTime?
  closesAt         DateTime?
  approvedAt       DateTime?
  approvedById     String?
  suspendedAt      DateTime?
  suspensionReason String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  startupProfile     StartupProfile?
  coAdmins           ProjectCoAdmin[]
  participations     Participation[]
  reports            Report[]
  documents          Document[]
  chatChannel        ChatChannel?
  leads              Lead[]
  resaleListings     ResaleListing[]
  distributions      DividendDistribution[]
  auditEntries       AuditLog[]
  infoRequests       InfoRequest[]
  pendingAssignments PendingAssignment[]
  shareholderClasses ShareholderClass[]
  externalHoldings   ExternalHolding[]

  @@index([status, kind])
  @@index([ownerId])
  @@index([approvedById])
}

model ProjectCoAdmin {
  projectId  String
  userId     String
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
  // userId es la segunda columna del PK compuesto, así que no está cubierto
  // para lookups por usuario solo (ej. "¿de qué proyectos soy co-admin?").
  @@index([userId])
}

// ─── PERFIL DE STARTUP ──────────────────────────────────────────────

enum StartupStage {
  IDEA
  PRE_SEED
  SEED
  EARLY_REVENUE
  GROWTH
  SCALE
}

enum FundingRoundType {
  FRIENDS_AND_FAMILY
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  SERIES_C_PLUS
  BRIDGE
  CONVERTIBLE_NOTE
  SAFE
}

model StartupProfile {
  id                String       @id @default(cuid())
  projectId         String       @unique
  project           Project      @relation(fields: [projectId], references: [id])
  legalName         String
  taxId             String?
  incorporationDate DateTime?
  jurisdiction      String
  location          String?
  targetRaiseAmount Decimal?     @db.Decimal(18, 2)
  sector            String
  oneLiner          String       @db.VarChar(160)
  problemStatement  String
  solutionStatement String
  businessModel     String
  stage             StartupStage
  preMoneyValuation Decimal?     @db.Decimal(18, 2)
  valuationCurrency String       @default("USD")
  totalEquityShares Int

  // Stake institucional AJDUT
  platformEquityPercent      Decimal @default(10.00) @db.Decimal(5, 2)
  platformEquityAgreementKey String?

  websiteUrl          String?
  videoUrl            String?
  pitchDeckStorageKey String?
  dataRoomStorageKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  founders      Founder[]
  fundingRounds FundingRound[]
  metrics       StartupMetric[]
  milestones    Milestone[]

  // Estructura y respaldo (texto informativo)
  assetBackingNote    String?
  equityStructureNote String?

  // Documentos opcionales (URLs externas: drive/dropbox/notion/etc.)
  projectionsUrl           String?
  planNegociosUrl          String?
  estrategiasPeriodicasUrl String?
  estadosFinancierosUrl    String?
  estrategiaEmisionUrl     String?

  // Políticas (texto libre informativo). Acciones / dividendos / frecuencia.
  policyShares       String?
  policyDividends    String?
  dividendsFrequency String?
}

model Founder {
  id               String         @id @default(cuid())
  startupProfileId String
  startupProfile   StartupProfile @relation(fields: [startupProfileId], references: [id])
  fullName         String
  role             String
  bio              String?
  references       String?
  linkedinUrl      String?
  equityPercent    Decimal        @db.Decimal(5, 2)
  joinedAt         DateTime?
  isActive         Boolean        @default(true)
}

model FundingRound {
  id                String           @id @default(cuid())
  startupProfileId  String
  startupProfile    StartupProfile   @relation(fields: [startupProfileId], references: [id])
  type              FundingRoundType
  announcedAt       DateTime
  closedAt          DateTime?
  amountRaised      Decimal          @db.Decimal(18, 2)
  currency          String           @default("USD")
  preMoneyValuation Decimal?         @db.Decimal(18, 2)
  notes             String?

  @@index([startupProfileId, closedAt])
}

enum MetricKind {
  MRR
  ARR
  GMV
  ACTIVE_USERS
  PAYING_CUSTOMERS
  CHURN_RATE
  BURN_RATE
  RUNWAY_MONTHS
  CAC
  LTV
  GROSS_MARGIN
  HEADCOUNT
  CUSTOM
}

enum MetricVisibility {
  PRIVATE // Solo founder / admin
  PUBLIC_TO_HOLDERS // Visible para socios del proyecto
}

model StartupMetric {
  id               String           @id @default(cuid())
  startupProfileId String
  startupProfile   StartupProfile   @relation(fields: [startupProfileId], references: [id])
  kind             MetricKind
  customLabel      String?
  value            Decimal          @db.Decimal(18, 4)
  unit             String
  asOf             DateTime
  reportedById     String
  sourceReportId   String?
  sourceReport     Report?          @relation(fields: [sourceReportId], references: [id])
  visibility       MetricVisibility @default(PUBLIC_TO_HOLDERS)
  createdAt        DateTime         @default(now())

  @@index([startupProfileId, kind, asOf])
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  ACHIEVED
  DELAYED
  CANCELLED
}

model Milestone {
  id               String          @id @default(cuid())
  startupProfileId String
  startupProfile   StartupProfile  @relation(fields: [startupProfileId], references: [id])
  title            String
  description      String
  targetDate       DateTime?
  achievedAt       DateTime?
  status           MilestoneStatus @default(PLANNED)
  createdAt        DateTime        @default(now())
}

// ─── PARTICIPACIONES Y CADENA INMUTABLE DE PROPIEDAD ────────────────

enum ParticipationStatus {
  AVAILABLE
  IN_NEGOTIATION
  ASSIGNED
  IN_RESALE
  TRANSFER_PENDING
}

model Participation {
  id                 String              @id @default(cuid())
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id])
  serialCode         String              @unique
  shareCount         Int
  status             ParticipationStatus @default(AVAILABLE)
  currentOwnerId     String?
  currentOwner       User?               @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  // Clase de accionista asignada por el owner — cap table por clases.
  shareholderClassId String?
  shareholderClass   ShareholderClass?   @relation(fields: [shareholderClassId], references: [id])
  acquiredAt         DateTime?
  isPlatformStake    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  history          OwnershipHistory[]
  certificates     Certificate[]
  leads            Lead[]
  resaleListings   ResaleListing[]
  dividendPayments DividendPayment[]

  @@index([projectId, status])
  @@index([projectId, isPlatformStake])
  @@index([currentOwnerId])
  // Hot path: chat.isChannelMember hace participation.count por (projectId, currentOwnerId)
  // en cada postMessage / createPoll / votePoll. Composite con equality columns.
  @@index([currentOwnerId, projectId])
}

model OwnershipHistory {
  id              String        @id @default(cuid())
  participationId String
  participation   Participation @relation(fields: [participationId], references: [id])
  fromUserId      String?
  fromUser        User?         @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUserId        String
  toUser          User          @relation("TransferTo", fields: [toUserId], references: [id])
  authorizedById  String
  authorizedBy    User          @relation("AuthorizedBy", fields: [authorizedById], references: [id])

  // Doble firma obligatoria cuando la participación es stake institucional
  coAuthorizedById String?
  coAuthorizedBy   User?   @relation("CoAuthorizedBy", fields: [coAuthorizedById], references: [id])

  reason          String
  resaleListingId String?        @unique
  resaleListing   ResaleListing? @relation(fields: [resaleListingId], references: [id])
  effectiveAt     DateTime
  validatedAt     DateTime       @default(now())

  // Cadena de hashes — cualquier mutación retroactiva la rompe
  blockHash String
  prevHash  String?

  @@index([participationId, validatedAt])
  @@index([toUserId])
  @@index([fromUserId])
  @@index([authorizedById])
  @@index([coAuthorizedById])
}

// ─── COMPOSICIÓN ACCIONARIA POR CLASES ──────────────────────────────
//
// El project owner agrupa a los accionistas en clases ("Directivo",
// "Operativo", "Inversionistas pasivos", "Promotor", etc.). Los miembros
// ven el cap table agregado por clase (cantidad de personas + %), sin
// nombres. Owner / admin siguen viendo el cap table nominal.

model ShareholderClass {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  participations   Participation[]
  externalHoldings ExternalHolding[]

  @@index([projectId, order])
}

// Tenencias declaradas por el owner que NO pasan por AJDUT — accionistas
// pre-existentes (founders, inversores previos). Es un agregado: cantidad
// de personas + de acciones, con su clase.
model ExternalHolding {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id])
  shareholderClassId String?
  shareholderClass   ShareholderClass? @relation(fields: [shareholderClassId], references: [id])
  label              String?
  peopleCount        Int               @default(1)
  shareCount         Int
  createdAt          DateTime          @default(now())

  @@index([projectId])
}

// ─── LEADS Y REVENTA ────────────────────────────────────────────────

enum LeadStatus {
  OPEN
  CONTACTED
  INTERVIEWING
  CONVERTED
  DISMISSED
  EXPIRED
}

enum LeadSupportKind {
  CAPITAL
  SPONSOR
  AMBASSADOR
  ADVISOR
  OTHER
}

model Lead {
  id                  String           @id @default(cuid())
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id])
  participationId     String?
  participation       Participation?   @relation(fields: [participationId], references: [id])
  userId              String
  user                User             @relation(fields: [userId], references: [id])
  message             String
  shareCountRequested Int              @default(1)
  supportKind         LeadSupportKind?
  status              LeadStatus       @default(OPEN)
  createdAt           DateTime         @default(now())
  expiresAt           DateTime // 30 días desde createdAt
  resolvedAt          DateTime?

  pendingAssignments PendingAssignment[]

  @@index([projectId, status])
  @@index([expiresAt, status])
  @@index([userId])
}

// ─── Solicitudes de información (etapa 1 del flujo de interés) ─────
//
// El usuario PARTNER aprieta "Quiero más información" y crea una InfoRequest.
// El founder la aprueba (desbloquea Documentos / Reportes y habilita el botón
// "Me interesa participar") o la rechaza. Es un gating ligero — no toca cap
// table ni Participation; sólo controla qué ve el viewer en la ficha.
enum InfoRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model InfoRequest {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  requesterId  String
  requester    User              @relation("InfoRequester", fields: [requesterId], references: [id])
  message      String?
  status       InfoRequestStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?             @relation("InfoRequestReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  createdAt    DateTime          @default(now())

  @@unique([projectId, requesterId])
  @@index([projectId, status])
}

enum ResaleStatus {
  LISTED
  IN_CONVERSATION
  AWAITING_VALIDATION
  COMPLETED
  CANCELLED
}

model ResaleListing {
  id              String        @id @default(cuid())
  participationId String
  participation   Participation @relation(fields: [participationId], references: [id])
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id])
  sellerId        String
  seller          User          @relation(fields: [sellerId], references: [id])
  intentNote      String
  contactChannel  String
  status          ResaleStatus  @default(LISTED)

  // Comprador propuesto al cerrar trato offline (cualquier User aprobado de AJDUT)
  proposedBuyerId String?
  // Evidencia de firma electrónica de ambas partes (in-app)
  sellerSignedAt  DateTime?
  buyerSignedAt   DateTime?

  // Checkbox obligatorio del founder antes de TRANSFER_PENDING
  rofrWaivedAt   DateTime?
  rofrWaivedById String?
  rofrWaiverNote String?

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  ownershipRecord OwnershipHistory?

  @@index([projectId, status])
  @@index([sellerId])
}

// ─── DOCUMENTACIÓN, CERTIFICADOS, CHAT ──────────────────────────────

enum ReportPeriod {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
  EXTRAORDINARY
}

enum ReportKind {
  QUARTERLY_FINANCIAL
  INVESTOR_UPDATE
  ANNUAL_AUDIT
  EXTRAORDINARY
}

model Report {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  kind        ReportKind   @default(QUARTERLY_FINANCIAL)
  period      ReportPeriod
  fiscalYear  Int
  title       String
  summary     String
  storageKey  String
  fileMime    String
  fileSizeKb  Int
  publishedAt DateTime     @default(now())
  publishedBy String

  metrics StartupMetric[]

  @@unique([projectId, fiscalYear, period, kind])
  @@index([projectId, publishedAt])
}

// ─── DOCUMENTOS ─────────────────────────────────────────────────────
// Archivo que el founder comparte con los miembros del proyecto. Toda la
// información (período, cifras, avances) vive DENTRO del archivo — la
// plataforma solo lo guarda y lo distribuye.
model Document {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  title        String
  storageKey   String
  fileMime     String?
  fileSizeKb   Int?
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([uploadedById])
}

model Certificate {
  id              String        @id @default(cuid())
  participationId String
  participation   Participation @relation(fields: [participationId], references: [id])
  issuedToUserId  String
  issuedAt        DateTime      @default(now())
  validUntil      DateTime?
  serialCode      String        @unique
  pdfStorageKey   String
  watermarkSeed   String
  disclaimerHash  String
  revokedAt       DateTime?
  revocationNote  String?

  @@index([participationId])
  @@index([issuedToUserId])
}

model ChatChannel {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())

  messages Message[]
  polls    Poll[]
}

model Message {
  id            String      @id @default(cuid())
  channelId     String
  channel       ChatChannel @relation(fields: [channelId], references: [id])
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  body          String
  attachmentKey String?
  // URL externa opcional para "adjuntar" un archivo sin storage físico. Mismo
  // patrón pragmático que documentos del proyecto: el founder/socio pega un
  // link a Drive/Dropbox/Notion/etc.
  attachmentUrl String?
  pinnedAt      DateTime?
  createdAt     DateTime    @default(now())
  editedAt      DateTime?
  // Soft delete por moderación: el owner/co-admin/admin "borra" el mensaje
  // (en realidad lo oculta). Queda visible para roles privilegiados.
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?       @relation("MessageDeleter", fields: [deletedById], references: [id])
  // TODO partial index on Message.deletedAt IS NULL: el feed del chat filtra
  // out mensajes soft-deleted en cada read. Un índice completo sobre deletedAt
  // sería poco eficiente (mayoría son NULL). Requiere raw SQL migration:
  //   CREATE INDEX ON "Message" ("channelId", "createdAt") WHERE "deletedAt" IS NULL;

  @@index([channelId, createdAt])
}

// ─── Votaciones / encuestas dentro del chat del proyecto ───────────
// Modelo simple: pregunta + opciones + votos por usuario. Sin pesos por
// participación (1 socio = 1 voto). El founder decide si permite múltiples
// respuestas por usuario y si fija una fecha de cierre.

model Poll {
  id          String      @id @default(cuid())
  channelId   String
  channel     ChatChannel @relation(fields: [channelId], references: [id])
  createdById String
  createdBy   User        @relation("PollCreator", fields: [createdById], references: [id])
  question    String
  multiple    Boolean     @default(false)
  closesAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime    @default(now())

  options PollOption[]

  @@index([channelId, createdAt])
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id])
  label  String
  order  Int        @default(0)
  votes  PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id])
  voterId   String
  voter     User       @relation("PollVoter", fields: [voterId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([optionId, voterId])
  @@index([optionId])
}

// ─── DIVIDENDOS ─────────────────────────────────────────────────────

enum DividendStatus {
  DRAFT
  ANNOUNCED
  IN_PAYOUT
  COMPLETED
  PARTIAL_CLOSED
  CANCELLED
}

enum DividendPaymentStatus {
  PENDING
  SENT
  RECEIVED
  DISPUTED
  WAIVED
}

model DividendDistribution {
  id                  String         @id @default(cuid())
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id])
  declaredById        String
  declaredBy          User           @relation("DividendDeclarer", fields: [declaredById], references: [id])
  title               String
  fiscalPeriod        String?
  notes               String?
  totalAmount         Decimal        @db.Decimal(18, 2)
  currency            String         @default("USD")
  recordDate          DateTime
  totalSharesAtRecord Int
  amountPerShare      Decimal        @db.Decimal(18, 8)
  supportingDocKey    String?
  disclaimerHash      String
  status              DividendStatus @default(DRAFT)
  announcedAt         DateTime?
  payoutStartedAt     DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  payments DividendPayment[]

  @@index([projectId, status])
  @@index([recordDate])
}

model DividendPayment {
  id                String                @id @default(cuid())
  distributionId    String
  distribution      DividendDistribution  @relation(fields: [distributionId], references: [id])
  participationId   String
  participation     Participation         @relation(fields: [participationId], references: [id])
  recipientId       String
  recipient         User                  @relation(fields: [recipientId], references: [id])
  shareCount        Int
  amount            Decimal               @db.Decimal(18, 2)
  currency          String
  isPlatformPayment Boolean               @default(false)
  status            DividendPaymentStatus @default(PENDING)

  // Marcado por el founder al pagar por fuera
  sentAt        DateTime?
  sentChannel   String?
  sentReference String?
  sentNote      String?

  // Confirmado por el holder (o Admin si es payment institucional)
  receivedAt        DateTime?
  receivedReference String?
  receivedNote      String?
  confirmedById     String?

  // Disputas
  disputedAt     DateTime?
  disputeReason  String?
  resolvedAt     DateTime?
  resolutionNote String?
  resolvedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([distributionId, status])
  @@index([recipientId, status])
  @@index([participationId])
  @@index([confirmedById])
  @@index([resolvedById])
}

model PlatformPayoutAccount {
  id          String   @id @default(cuid())
  currency    String   @unique
  accountName String
  bankName    String
  accountId   String
  swiftBic    String?
  notes       String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String
}

// ─── AUDITORÍA Y NOTIFICACIONES ─────────────────────────────────────

// ─── AuditLog retention strategy (notas — NO implementado todavía) ──
// Esta tabla crece sin límite. Hoy no hay partitioning ni retention job;
// es un trade-off consciente porque AJDUT es chico y la auditoría es la
// fuente de verdad de toda la operación. Cuando el volumen empiece a
// pesar (índices grandes, queries lentas en /admin/auditoria), aplicar:
//
//  1) Retention job mensual (Vercel cron):
//     · borrar entries con createdAt > 12 meses para acciones NO críticas
//       (CHAT.*, EMAIL.FAILED, RATE_LIMIT.HIT, INFO_REQUEST.*, etc.).
//     · La cron corre en /api/cron/audit-retention con CRON_SECRET y hace
//       deleteMany por chunks (cuidado con el lock del row del WAL en PG).
//
//  2) NUNCA borrar (audit-of-record para operaciones financieras y de
//     propiedad — necesario para reconstrucciones legales/forenses):
//     · PARTICIPATION.*      → creación, asignación, transferencia, reventa
//     · CERTIFICATE.*        → emisión / revocación de certificados
//     · DISTRIBUTION.*       → dividendos: draft, anuncio, pagos, disputas
//     · OWNERSHIP-related actions vía OwnershipHistory (otro modelo)
//
//  3) Eventualmente, month-partitioning vía raw SQL (PG 14+ native
//     partitioning por createdAt). Requiere migration manual fuera de
//     Prisma — schema sólo declara la tabla parent; los hijos los crea
//     un job pg con pg_partman o equivalente.
//
//  4) Mientras tanto: el índice partial sobre action <> 'EMAIL.FAILED'
//     (ver TODO abajo) es el primer mitigation barato a aplicar.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  action     String
  entityType String
  entityId   String
  payload    Json
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  // TODO partial index: idealmente WHERE action <> 'EMAIL.FAILED' para reducir
  // tamaño del índice (EMAIL.FAILED es el 80%+ de rows). Prisma no expresa
  // partial indexes; requiere raw SQL migration cuando lo tomemos.

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([projectId, createdAt])
  // /admin/auditoria filtra por action != "EMAIL.FAILED" + range por createdAt.
  // Composite [action, createdAt] permite range-scan eficiente sobre enums.
  @@index([action, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ─── PROPUESTAS DE ASIGNACIÓN (Ola 5) ───────────────────────────────
//
// Toda asignación de acciones (sea desde un lead aceptado por el founder, sea
// desde una invitación directa del founder a un email) queda primero como
// PendingAssignment con status PENDING. Recién cuando un ADMIN la aprueba se
// ejecuta la asignación real (assignSharesFromLead / assignSharesToInvestor).
// Esto le da al equipo de AJDUT control de gatekeeping sobre toda emisión de
// participaciones, sin que el founder pueda quemarse acciones por error.

enum PendingAssignmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PendingAssignmentSource {
  LEAD
  INVITE
}

model PendingAssignment {
  id           String                  @id @default(cuid())
  projectId    String
  project      Project                 @relation(fields: [projectId], references: [id])
  proposedById String
  proposedBy   User                    @relation("PendingAssignmentProposer", fields: [proposedById], references: [id])
  source       PendingAssignmentSource

  // Si viene de un lead existente:
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  // Si viene de invitación directa (founder propone invitar a email):
  inviteEmail    String?
  inviteFullName String?
  inviteMessage  String?

  // Destinatario: usuario existente (si lo hay)
  targetUserId String?
  targetUser   User?   @relation("PendingAssignmentTarget", fields: [targetUserId], references: [id])

  shareCount Int
  reason     String?

  status       PendingAssignmentStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                   @relation("PendingAssignmentReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?

  createdAt DateTime @default(now())

  @@index([projectId, status])
  @@index([status])
}
